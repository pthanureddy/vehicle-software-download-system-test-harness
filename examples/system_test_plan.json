{
  "plan_id": "swdl-complete-system-regression-2026.40.0",
  "description": "Requirements-based SWDL scenarios over a deterministic software loopback",
  "scenarios": [
    {
      "id": "SWDL-SYS-001",
      "requirement_id": "REQ-SWDL-001",
      "name": "Install a compatible three-ECU baseline in dependency order",
      "expected": {
        "status": "COMPLETED",
        "failure_code": null,
        "updated_ecu_count": 3,
        "rollback_count": 0,
        "versions": {"gateway": "5.5.0", "ccm": "2.2.0", "infotainment": "9.4.0"}
      }
    },
    {
      "id": "SWDL-SYS-002",
      "requirement_id": "REQ-SWDL-002",
      "name": "Retry and resume after a transient Ethernet-style chunk loss",
      "faults": {"drop_once": {"gateway": [1]}},
      "expected": {
        "status": "COMPLETED",
        "failure_code": null,
        "updated_ecu_count": 3,
        "minimum_retry_count": 1,
        "versions": {"gateway": "5.5.0", "ccm": "2.2.0", "infotainment": "9.4.0"}
      }
    },
    {
      "id": "SWDL-SYS-003",
      "requirement_id": "REQ-SWDL-003",
      "name": "Reject a corrupted image and roll back previously activated ECUs",
      "faults": {"corrupt": {"ccm": [0]}},
      "expected": {
        "status": "FAILED",
        "failure_code": "IMAGE_HASH_MISMATCH",
        "updated_ecu_count": 0,
        "rollback_count": 1,
        "versions": {"gateway": "5.4.2", "ccm": "2.1.0", "infotainment": "9.3.1"}
      }
    },
    {
      "id": "SWDL-SYS-004",
      "requirement_id": "REQ-SWDL-004",
      "name": "Block the campaign when battery voltage is below the download threshold",
      "overrides": {"battery_voltage": 11.7},
      "expected": {
        "status": "BLOCKED",
        "failure_code": "LOW_BATTERY_VOLTAGE",
        "updated_ecu_count": 0,
        "versions": {"gateway": "5.4.2", "ccm": "2.1.0", "infotainment": "9.3.1"}
      }
    },
    {
      "id": "SWDL-SYS-005",
      "requirement_id": "REQ-SWDL-005",
      "name": "Block the campaign outside the permitted service ignition state",
